# Боевой Caddy: HTTPS от Let's Encrypt сам, API — в бэкенд, остальное — собранный фронт.
# DOMAIN приходит из .env (например, lisa52.com).

# Промежуточный сервер в Казахстане (30.09): из РФ провайдеры замораживают соединения с
# нашим хостером, поэтому игроки ходят через машину другого хостера. Она пересылает TCP как
# есть и в начале соединения передаёт настоящий IP игрока по PROXY protocol — верим этому
# только с её адресов, остальные соединения идут напрямую, как раньше.
{
	servers {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow {$RELAY_CIDRS:212.116.233.109/32}
				fallback_policy skip
			}
			tls
		}
	}
}

{$DOMAIN}, ru.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		# Данные API не индексируются и не идут на обучение ИИ (правила: /terms).
		header X-Robots-Tag "noindex, nofollow, noai, noimageai"
		# Скриншоты и картинки в тредах — до 10 МБ, с запасом на multipart.
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:8000
	}

	handle {
		root * /srv/frontend

		# Файлы сборки с хешем в имени не меняются — кэшируем надолго.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Service worker, манифест и index.html — всегда свежие, иначе обновление не доедет.
		@fresh path /sw.js /manifest.webmanifest /index.html /
		header @fresh Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
