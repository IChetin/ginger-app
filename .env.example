# Application
APP_ENV=development
APP_NAME=Ginger
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:8080

# OTP / session
OTP_HMAC_SECRET=dev-otp-hmac-secret-change-me
# Used only with EMAIL_PROVIDER=mock in development/test. Never returned by API.
DEV_OTP_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MIN_INTERVAL_SECONDS=60
OTP_DAILY_LIMIT=5
OTP_IP_HOURLY_LIMIT=20
SESSION_COOKIE_NAME=ginger_session
SESSION_TTL_DAYS=30
# Production must set SESSION_COOKIE_SECURE=true (HTTPS).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Password auth / email verification links
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_LOGIN_MAX_ATTEMPTS=5
PASSWORD_LOGIN_LOCKOUT_SECONDS=900
EMAIL_VERIFY_TTL_SECONDS=86400
EMAIL_VERIFY_MIN_INTERVAL_SECONDS=60
EMAIL_VERIFY_DAILY_LIMIT=5
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_RESET_MIN_INTERVAL_SECONDS=60
PASSWORD_RESET_DAILY_LIMIT=5
AUTH_TOKEN_IP_HOURLY_LIMIT=20
FRONTEND_BASE_URL=http://localhost:5173

# Email adapter: mock (dev/test only) | smtp | postbox
# Production with mock is fail-closed (503 email_unavailable).
# После заполнения SMTP_* поставь EMAIL_PROVIDER=smtp и пересоздай backend.
EMAIL_PROVIDER=mock
# Yandex 465+SSL: smtp.yandex.ru, SMTP_USE_SSL=true, SMTP_USE_TLS=false
# Yandex 587+STARTTLS: smtp.yandex.ru, SMTP_USE_SSL=false, SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Адрес From (часто совпадает с SMTP_USER / подтверждённый алиас)
SMTP_FROM=
SMTP_FROM_NAME=Ginger
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# Yandex Cloud Postbox по HTTPS: EMAIL_PROVIDER=postbox, отправитель — SMTP_FROM/SMTP_FROM_NAME.
# Ключ — статический ключ доступа сервисного аккаунта с ролью postbox.sender.
POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
POSTBOX_REGION=ru-central1
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=

# Captcha: mock (dev/test) | yandex
CAPTCHA_PROVIDER=mock
CAPTCHA_MOCK_TOKEN=ok
SMARTCAPTCHA_SERVER_KEY=
# Frontend public client key (Vite)
VITE_SMARTCAPTCHA_CLIENT_KEY=
VITE_TELEGRAM_SUPPORT_URL=

# Web Push VAPID.
# Generate applicationServerKey (public) + private raw key:
#   cd worker && uv run python - <<'PY'
#   from py_vapid import Vapid01
#   import base64
#   v = Vapid01(); v.generate_keys()
#   nums = v.public_key.public_numbers()
#   raw = b"\x04" + nums.x.to_bytes(32, "big") + nums.y.to_bytes(32, "big")
#   print("VAPID_PUBLIC_KEY=" + base64.urlsafe_b64encode(raw).rstrip(b"=").decode())
#   priv = v.private_key.private_numbers().private_value.to_bytes(32, "big")
#   print("VAPID_PRIVATE_KEY=" + base64.urlsafe_b64encode(priv).rstrip(b"=").decode())
#   PY
# Or: npx web-push generate-vapid-keys
# Private key is used by worker only. Never commit real keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://lisa52.com
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_JOB_INTERVAL_SECONDS=60

# CBR FX rates (worker daily cron, UTC). Default 01:15 UTC.
FX_JOB_CRON=15 1 * * *
CBR_BASE_URL=https://www.cbr.ru/scripts/XML_daily.asp
CBR_TIMEOUT_SECONDS=15
CBR_RETRIES=3

# Schedule import (stage 8 foundation). Files stored in Postgres BYTEA.
IMPORT_MAX_FILE_BYTES=20971520

# Seeded editor/admin for local development only (APP_ENV=development).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NICKNAME=admin
SEED_EDITOR_EMAIL=editor@example.com
SEED_EDITOR_NICKNAME=editor
# Comma-separated emails that always get admin in any APP_ENV. Cannot be demoted via /admin/users.
SUPERADMIN_EMAILS=

# PostgreSQL
POSTGRES_USER=day2
POSTGRES_PASSWORD=day2
POSTGRES_DB=day2
POSTGRES_PORT=5432

# Backend connects to the compose service hostname `postgres`
DATABASE_URL=postgresql+asyncpg://day2:day2@postgres:5432/day2
DATABASE_ECHO=false

# Isolated test PostgreSQL (`docker compose --profile test up -d postgres_test`)
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql+asyncpg://day2:day2@localhost:5433/day2_test

# Published edge port (Caddy). Use 8080 if host :80 is already taken.
HTTP_PORT=80

# Сборщик лобби (телефон + скрипт): постоянный токен, пусто — приём данных выключен
COLLECTOR_TOKEN=

# Минимальная сборка фронта: клиент старее получает 426 и перезагружается.
# Ставит deploy.sh --force-update; пусто — проверка выключена
MIN_CLIENT_BUILD=

# Telegram-бот уведомлений: токен от @BotFather и имя бота без @; пусто — бот выключен
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
